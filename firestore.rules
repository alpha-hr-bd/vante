rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    match /orders/{id} {
      allow get: if true;            // order IDs are random and unguessable; the tracking page also checks the phone number
      allow list, update, delete: if isAdmin();
      allow create: if request.resource.data.status == 'Pending'
        && request.resource.data.method in ['bKash', 'Nagad', 'Cash on Delivery']
        && request.resource.data.paymentStatus in ['Pending Verification', 'Cash on Delivery']
        && (request.resource.data.method == 'Cash on Delivery'
            ? request.resource.data.paymentStatus == 'Cash on Delivery'
            : request.resource.data.paymentStatus == 'Pending Verification' && request.resource.data.txnId.size() > 3)
        && request.resource.data.orderId == id
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.name.size() < 100 && request.resource.data.address.size() < 400;
    }
  }
}
